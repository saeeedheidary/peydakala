/**
 * PidaKala Search API - Production Ready
 * Netlify Serverless Function
 */

const CONFIG = Object.freeze({
  MAX_QUERY_LENGTH: 180,
  DEFAULT_TIMEOUT_MS: 12000,
  MAX_RESULTS: 10,
  CACHE_CONTROL: 'no-store, no-cache, must-revalidate, proxy-revalidate',
  CORS_ORIGIN: '*',
});

const BLOCKED_DOMAINS = Object.freeze([
  'facebook.com', 'instagram.com', 'tiktok.com',
  'youtube.com', 'wikipedia.org', 'reddit.com',
  'pinterest.com', 'linkedin.com', 'twitter.com',
  'x.com', 't.co', 'telegram.org', 'discord.com',
]);

const COMMERCE_KEYWORDS = Object.freeze([
  'خرید', 'فروشگاه', 'قیمت', 'سفارش', 'محصول',
  'shop', 'store', 'buy', 'price', 'product', 'order',
  'فروش', 'تخفیف', 'ارزان', 'اصل', 'گارانتی',
]);

const DIVERSITY_KEYWORDS = Object.freeze([
  'تنوع', 'برند', 'محصولات', 'دسته‌بندی',
  'variety', 'brands', 'catalog', 'collection',
  'مدل', 'رنگ', 'سایز', 'گوناگون',
]);

function extractHost(url) {
  if (!url || typeof url !== 'string') return '';
  try {
    return new URL(url).hostname.toLowerCase().replace(/^www\./, '');
  } catch {
    return '';
  }
}

function generateRequestId() {
  return `${Date.now()}-${Math.random().toString(36).substring(2, 11)}`;
}

function isBlockedDomain(host) {
  if (!host) return true;
  return BLOCKED_DOMAINS.some(d => host === d || host.endsWith(`.${d}`));
}

function sanitizeInput(input) {
  if (!input) return '';
  return input
    .trim()
    .replace(/[<>\"']/g, '')
    .replace(/\s+/g, ' ')
    .substring(0, CONFIG.MAX_QUERY_LENGTH);
}

function buildSearchQuery(query) {
  const hasPersian = /[\u0600-\u06FF]/.test(query);
  return hasPersian
    ? `${query} خرید فروشگاه قیمت`
    : `${query} buy price shop store product`;
}

function calculateScore(item) {
  const text = `${item.title || ''} ${item.snippet || ''} ${item.link || ''}`.toLowerCase();
  let score = 40;

  for (const word of COMMERCE_KEYWORDS) {
    if (text.includes(word)) score += 4;
  }
  for (const word of DIVERSITY_KEYWORDS) {
    if (text.includes(word)) score += 3;
  }
  if ((item.link || '').startsWith('https://')) score += 4;
  if (item.pagemap?.product || item.pagemap?.offer) score += 8;

  return Math.min(100, Math.max(0, score));
}

function createResponse(statusCode, data, options = {}) {
  const headers = {
    'Content-Type': 'application/json; charset=utf-8',
    'Cache-Control': options.cacheControl || CONFIG.CACHE_CONTROL,
    'X-Content-Type-Options': 'nosniff',
    'X-Frame-Options': 'DENY',
    'Access-Control-Allow-Origin': CONFIG.CORS_ORIGIN,
    'Access-Control-Allow-Methods': 'GET, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
  };

  if (options.requestId) {
    headers['X-Request-Id'] = options.requestId;
  }

  return {
    statusCode,
    headers,
    body: JSON.stringify({
      success: statusCode >= 200 && statusCode < 300,
      ...data,
      ...(options.requestId && { requestId: options.requestId }),
    }),
  };
}

function createTimeoutSignal(ms) {
  if (typeof AbortSignal?.timeout === 'function') {
    return AbortSignal.timeout(ms);
  }
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), ms);
  controller.signal.addEventListener('abort', () => clearTimeout(timeoutId), { once: true });
  return controller.signal;
}

export const handler = async (event) => {
  const requestId = generateRequestId();

  if (event.httpMethod === 'OPTIONS') {
    return createResponse(204, {}, { requestId });
  }

  if (event.httpMethod !== 'GET') {
    return createResponse(405, { error: 'فقط درخواست GET مجاز است.' }, { requestId });
  }

  const query = sanitizeInput(event.queryStringParameters?.q);

  if (!query) {
    return createResponse(400, { error: 'لطفاً نام کالا یا خدمت را وارد کنید.', code: 'MISSING_QUERY' }, { requestId });
  }

  if (query.length > CONFIG.MAX_QUERY_LENGTH) {
    return createResponse(400, { error: 'عبارت جست‌وجو بیش از حد طولانی است.', code: 'QUERY_TOO_LONG' }, { requestId });
  }

  const apiKey = process.env.GOOGLE_CSE_API_KEY;
  const searchEngineId = process.env.GOOGLE_CSE_CX;

  if (!apiKey || !searchEngineId) {
    return createResponse(503, { error: 'سرویس جست‌وجو پیکربندی نشده است.', code: 'SERVICE_MISCONFIGURED' }, { requestId });
  }

  try {
    const apiUrl = new URL('https://www.googleapis.com/customsearch/v1');
    apiUrl.searchParams.set('key', apiKey);
    apiUrl.searchParams.set('cx', searchEngineId);
    apiUrl.searchParams.set('q', buildSearchQuery(query));
    apiUrl.searchParams.set('num', String(CONFIG.MAX_RESULTS));
    apiUrl.searchParams.set('safe', 'active');

    const response = await fetch(apiUrl.toString(), {
      signal: createTimeoutSignal(CONFIG.DEFAULT_TIMEOUT_MS),
      headers: { 'Accept': 'application/json' },
    });

    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}));
      console.error(`[${requestId}] Google API ${response.status}:`, errorData);

      const messages = {
        400: 'درخواست نامعتبر.',
        403: 'دسترسی محدود شده - کلید API را بررسی کنید.',
        429: 'سهمیه به پایان رسید. لطفاً بعداً تلاش کنید.',
      };

      return createResponse(502, {
        error: messages[response.status] || 'سرویس جست‌وجو خطا داد.',
        code: 'SEARCH_PROVIDER_ERROR',
        status: response.status,
      }, { requestId });
    }

    let data;
    try {
      data = await response.json();
    } catch {
      return createResponse(502, { error: 'پاسخ نامعتبر از سرویس جست‌وجو.', code: 'INVALID_RESPONSE' }, { requestId });
    }

    const seenHosts = new Set();
    const results = (data.items || [])
      .filter(item => item?.link)
      .map(item => ({
        title: item.title || extractHost(item.link),
        link: item.link,
        snippet: item.snippet || '',
        host: extractHost(item.link),
        score: calculateScore(item),
      }))
      .filter(item => {
        if (!item.host || isBlockedDomain(item.host) || seenHosts.has(item.host)) return false;
        seenHosts.add(item.host);
        return true;
      })
      .sort((a, b) => b.score - a.score)
      .slice(0, CONFIG.MAX_RESULTS)
      .map((item, index) => ({
        rank: index + 1,
        title: item.title,
        link: item.link,
        snippet: item.snippet,
        host: item.host,
        score: item.score,
        reason: item.score >= 70
          ? 'نشانه‌های تجاری و ارتباط متنی قوی‌تر'
          : 'نتیجه مرتبط؛ اعتبار فروشگاه را بررسی کنید',
      }));

    return createResponse(200, {
      query,
      results,
      note: 'امتیازها تخمینی هستند و اعتبار واقعی فروشگاه را تضمین نمی‌کنند.',
    }, { requestId });

  } catch (error) {
    const isTimeout = error.name === 'TimeoutError' || error.name === 'AbortError';
    console.error(`[${requestId}] ${isTimeout ? 'Timeout' : 'Error'}:`, error.message);

    return createResponse(500, {
      error: isTimeout ? 'سرویس زمان‌بر شد. دوباره تلاش کنید.' : 'ارتباط با سرویس جست‌وجو برقرار نشد.',
      code: isTimeout ? 'TIMEOUT' : 'INTERNAL_ERROR',
    }, { requestId });
  }
};
