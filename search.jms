
const BLOCKED = [
  'facebook.com', 'instagram.com', 'tiktok.com',
  'youtube.com', 'wikipedia.org', 'reddit.com',
  'pinterest.com', 'linkedin.com'
];

function hostOf(url) {
  try {
    return new URL(url).hostname.replace(/^www\./, '').toLowerCase();
  } catch {
    return '';
  }
}

function reply(statusCode, data) {
  return {
    statusCode,
    headers: {
      'content-type': 'application/json; charset=utf-8',
      'cache-control': 'no-store'
    },
    body: JSON.stringify(data)
  };
}

function scoreResult(item) {
  const text = `${item.title || ''} ${item.snippet || ''} ${item.link || ''}`.toLowerCase();
  const commerce = ['خرید', 'فروشگاه', 'قیمت', 'سفارش', 'محصول', 'shop', 'store', 'buy', 'price', 'product'];
  const diversity = ['تنوع', 'برند', 'محصولات', 'دسته‌بندی', 'variety', 'brands', 'catalog'];
  let score = 40;

  for (const word of commerce) {
    if (text.includes(word)) score += 4;
  }
  for (const word of diversity) {
    if (text.includes(word)) score += 3;
  }
  if ((item.link || '').startsWith('https://')) score += 4;
  if (item.pagemap && (item.pagemap.product || item.pagemap.offer)) score += 8;

  return Math.min(100, score);
}

export const handler = async (event) => {
  const q = (event.queryStringParameters?.q || '').trim();

  if (!q) return reply(400, { error: 'لطفاً نام کالا یا خدمت را وارد کنید.' });
  if (q.length > 180) return reply(400, { error: 'عبارت جست‌وجو بیش از حد طولانی است.' });

  const key = process.env.GOOGLE_CSE_API_KEY;
  const cx = process.env.GOOGLE_CSE_CX;

  if (!key || !cx) {
    return reply(503, {
      error: 'موتور جست‌وجو پیکربندی نشده است. تنظیمات API در Netlify را بررسی کنید.'
    });
  }

  try {
    const url = new URL('https://www.googleapis.com/customsearch/v1');
    url.searchParams.set('key', key);
    url.searchParams.set('cx', cx);
    url.searchParams.set('q', `${q} خرید فروشگاه قیمت`);
    url.searchParams.set('num', '10');

    const response = await fetch(url, {
      signal: AbortSignal.timeout(12000)
    });
    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      console.error('Google API status:', response.status);
      return reply(502, {
        error: 'سرویس جست‌وجو خطا داد. کلید API، شناسه موتور جست‌وجو و سهمیه را بررسی کنید.'
      });
    }

    const seen = new Set();
    const results = (data.items || [])
      .filter(item => item.link)
      .map(item => ({
        title: item.title || hostOf(item.link),
        link: item.link,
        snippet: item.snippet || '',
        host: hostOf(item.link),
        score: scoreResult(item)
      }))
      .filter(item => {
        const blocked = BLOCKED.some(domain =>
          item.host === domain || item.host.endsWith('.' + domain)
        );
        if (!item.host || blocked || seen.has(item.host)) return false;
        seen.add(item.host);
        return true;
      })
      .sort((a, b) => b.score - a.score)
      .slice(0, 10)
      .map((item, index) => ({
        ...item,
        rank: index + 1,
        reason: item.score >= 70
          ? 'نشانه‌های تجاری و ارتباط متنی قوی‌تر'
          : 'نتیجه مرتبط؛ اعتبار فروشگاه را بررسی کنید'
      }));

    return reply(200, {
      query: q,
      results,
      note: 'امتیازها تخمینی هستند و اعتبار واقعی فروشگاه را تضمین نمی‌کنند.'
    });
  } catch (error) {
    console.error('Search error:', error.message);
    return reply(500, {
      error: 'ارتباط با سرویس جست‌وجو برقرار نشد.'
    });
  }
};
